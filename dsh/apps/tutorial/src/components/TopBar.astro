---
/**
 * 覆盖 TutorialKit 默认的顶栏：默认 Logo 的图片没有 alt、链接没有可读名称。
 * 其余按钮仍用 TutorialKit 通过 slot 传入的组件。
 */
---

<nav
  aria-label="站点"
  class="bg-tk-elements-topBar-backgroundColor transition-theme border-b border-tk-elements-app-borderColor flex max-w-full items-center p-3 px-4 min-h-[56px]"
>
  <div class="flex flex-1">
    <a
      href="/"
      class="flex items-center text-tk-elements-topBar-logo-color hover:text-tk-elements-topBar-logo-colorHover"
    >
      <img class="h-5 w-auto dark:hidden" src="/logo.svg" alt="Harness Explorer 首页" />
      <img class="h-5 w-auto hidden dark:inline-block" src="/logo-dark.svg" alt="Harness Explorer 首页" />
    </a>
  </div>
  <div class="mr-2">
    <slot name="download-button" />
  </div>
  <div>
    <slot name="theme-switch" />
  </div>
</nav>
